# Refinr - environment template.
# Copy to .env (git-ignored) and fill in your own values:  cp .env.example .env
# Only dummy values here. Never commit a real .env.

# --- Confluence ---
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_TOKEN=your-atlassian-api-token

# --- Jira ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=PROJ
# false for a team-managed (next-gen) project, which has no priority field
JIRA_PRIORITY_ENABLED=true
# Story points custom field (e.g. customfield_10016); empty = story points not sent
JIRA_STORY_POINTS_FIELD=

# --- HTTP security ---
# Browser origins allowed to call the API (CORS), comma-separated; '*' is refused. Empty = same origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host names accepted in the Host header (DNS rebinding protection), comma-separated, port ignored; '*' is refused.
# Used by both the backend and the frontend (nginx). Add the DNS name or IP used to reach Refinr over the network.
REFINR_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional API key: when set, every /api/** call must send the X-API-Key header (except /api/v1/health).
# Empty = disabled (local use). With Docker Compose, the frontend proxy adds it server-side.
REFINR_API_KEY=

# --- LLM: document analysis ---
# provider: anthropic | google | openai-compatible (OpenAI, DeepSeek, Mistral, Groq, OpenRouter, Ollama, LiteLLM, vLLM)
# Default: local Ollama through its OpenAI-compatible API (no key needed).
# Docker Compose: "localhost" is the container itself. Use http://host.docker.internal:11434/v1 (Ollama on your
# machine) or http://ollama:11434/v1 (docker compose --profile ollama).
LLM_ANALYSIS_PROVIDER=openai-compatible
LLM_ANALYSIS_BASE_URL=http://localhost:11434/v1
LLM_ANALYSIS_MODEL=qwen3:8b
LLM_ANALYSIS_API_KEY=
# Ollama: disables the thinking phase of reasoning models (qwen3...); leave empty for providers that reject it
LLM_ANALYSIS_REASONING_EFFORT=none
# Examples:
#   google:     LLM_ANALYSIS_PROVIDER=google     LLM_ANALYSIS_BASE_URL=   LLM_ANALYSIS_MODEL=gemini-2.5-flash   LLM_ANALYSIS_API_KEY=your-gemini-api-key
#   anthropic:  LLM_ANALYSIS_PROVIDER=anthropic  LLM_ANALYSIS_BASE_URL=   LLM_ANALYSIS_MODEL=claude-opus-5-5    LLM_ANALYSIS_API_KEY=your-anthropic-api-key (not tested against the real API yet)
#   (google / anthropic: keep LLM_ANALYSIS_BASE_URL empty for the official URL, otherwise calls go to the Ollama URL above)
#   OpenAI:     LLM_ANALYSIS_PROVIDER=openai-compatible  LLM_ANALYSIS_BASE_URL=https://api.openai.com/v1  LLM_ANALYSIS_MODEL=your-openai-model  LLM_ANALYSIS_API_KEY=your-openai-api-key  LLM_ANALYSIS_REASONING_EFFORT=
#     (OpenAI: not tested against the real API yet)
#   OpenAI reasoning models (they reject temperature and max_tokens): same as OpenAI, plus
#               LLM_ANALYSIS_TEMPERATURE=   LLM_ANALYSIS_MAX_TOKENS_PARAM=max_completion_tokens
#               (empty temperature = not sent; same keys with LLM_VERDICT_ for a separate verdict provider)

# --- LLM: ai-ready verdict (optional; empty provider = verdict produced by the analysis) ---
LLM_VERDICT_PROVIDER=
LLM_VERDICT_BASE_URL=
LLM_VERDICT_MODEL=
LLM_VERDICT_API_KEY=
LLM_VERDICT_REASONING_EFFORT=
# Example (LiteLLM proxy): LLM_VERDICT_PROVIDER=openai-compatible  LLM_VERDICT_BASE_URL=http://localhost:4000/v1  LLM_VERDICT_MODEL=gemini-2.5-flash  LLM_VERDICT_API_KEY=your-litellm-key
