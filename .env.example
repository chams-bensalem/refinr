# Refinr - environment template.
# Copy to .env (git-ignored) and fill in your own values:  cp .env.example .env
# Only dummy values here. Never commit a real .env.

# --- Document source of this instance: confluence (default), bookstack or xwiki ---
SOURCE_PROVIDER=confluence

# --- Confluence (when SOURCE_PROVIDER=confluence) ---
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_TOKEN=your-atlassian-api-token

# --- BookStack (when SOURCE_PROVIDER=bookstack) ---
BOOKSTACK_BASE_URL=https://bookstack.example.com
BOOKSTACK_TOKEN_ID=your-bookstack-token-id
BOOKSTACK_TOKEN_SECRET=your-bookstack-token-secret
# Address used for the links in the web UI; empty = BOOKSTACK_BASE_URL (e.g. http://localhost:8091 when the base URL is host.docker.internal)
BOOKSTACK_WEB_URL=

# --- XWiki (when SOURCE_PROVIDER=xwiki; HTTP Basic, use HTTPS) ---
XWIKI_BASE_URL=https://xwiki.example.com
XWIKI_USERNAME=refinr_bot
XWIKI_PASSWORD=your-xwiki-password
# Address used for the links in the web UI; empty = XWIKI_BASE_URL
XWIKI_WEB_URL=
XWIKI_WIKI=xwiki

# --- Issue tracker of this instance: jira (default) or openproject ---
TRACKER_PROVIDER=jira

# --- Jira ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=PROJ
# false for a team-managed (next-gen) project, which has no priority field
JIRA_PRIORITY_ENABLED=true
# Story points custom field (e.g. customfield_10016); empty = story points not sent
JIRA_STORY_POINTS_FIELD=

# --- OpenProject (when TRACKER_PROVIDER=openproject) ---
OPENPROJECT_BASE_URL=https://openproject.example.com
OPENPROJECT_API_KEY=your-openproject-api-key
# Address used for the links in the web UI; empty = OPENPROJECT_BASE_URL (e.g. http://localhost:8090 when the base URL is host.docker.internal)
OPENPROJECT_WEB_URL=
OPENPROJECT_PROJECT=my-project
# OPENPROJECT_TYPE_EPIC=Epic
# OPENPROJECT_TYPE_STORY=User story
# OPENPROJECT_TYPE_SUBTASK=Task
# OPENPROJECT_READINESS_FIELD=Agent readiness
# OPENPROJECT_STORY_POINTS_ENABLED=true
# OPENPROJECT_PRIORITY_ENABLED=true

# --- Document provided as text (content field of analyze-preview / analyze-and-create) ---
# Maximum size in Unicode characters, title included; above it the request gets a 413.
DOCUMENT_MAX_CONTENT_CHARS=200000

# --- HTTP security ---
# Browser origins allowed to call the API (CORS), comma-separated; '*' is refused. Empty = same origin only.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Host names accepted in the Host header (DNS rebinding protection), comma-separated, port ignored; '*' is refused.
# Used by both the backend and the frontend (nginx). Add the DNS name or IP used to reach Refinr over the network.
REFINR_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional API key: when set, every /api/** call must send the X-API-Key header (except /api/v1/health).
# Empty = disabled (local use). With Docker Compose, the frontend proxy adds it server-side.
REFINR_API_KEY=
# Maximum request body size in bytes (default 5 MiB, same as the frontend proxy); above it the request gets a 413.
HTTP_MAX_BODY_BYTES=5242880

# --- LLM: document analysis ---
# provider: anthropic | google | openai-compatible (OpenAI, DeepSeek, Mistral, Groq, OpenRouter, Ollama, LiteLLM, vLLM)
# Provider and model are required (no default: Refinr makes no assumption about the model). Example below: local Ollama
# through its OpenAI-compatible API (no key needed).
# Docker Compose: "localhost" is the container itself. Use http://host.docker.internal:11434/v1 (Ollama on your
# machine) or http://ollama:11434/v1 (docker compose --profile ollama).
LLM_ANALYSIS_PROVIDER=openai-compatible
LLM_ANALYSIS_BASE_URL=http://localhost:11434/v1
LLM_ANALYSIS_MODEL=qwen3:8b
LLM_ANALYSIS_API_KEY=
# Ollama: disables the thinking phase of reasoning models (qwen3...); leave empty for providers that reject it
LLM_ANALYSIS_REASONING_EFFORT=none
# Temperature: empty = not sent (the provider applies its own default); otherwise sent as is to every provider.
# Before 1.4 the default was 0.2 (analysis) and 0.1 (verdict).
LLM_ANALYSIS_TEMPERATURE=
# Langue de sortie : auto (detection francais / anglais, francais par defaut) ou un code ISO 639-1 (fr, en, de...)
LLM_OUTPUT_LANGUAGE=auto
LLM_VERDICT_TEMPERATURE=
# Provider-specific parameters (extra-body): write the dotted property name as is, so a camelCase key keeps its case
# (the upper-case REFINR_LLM_..._EXTRABODY_... form loses it). Examples, to check in your provider's documentation:
#   google:            refinr.llm.analysis.extra-body.generationConfig.thinkingConfig.thinkingLevel=low
#   anthropic:         refinr.llm.analysis.extra-body.output_config.effort=low
#                      refinr.llm.analysis.extra-body.thinking={"type":"adaptive"}
#   openai-compatible: LLM_ANALYSIS_REASONING_EFFORT above (= refinr.llm.analysis.extra-body.reasoning_effort)
# Same keys with refinr.llm.verdict.extra-body. for a separate verdict provider.
# Examples (model names are examples only: use any model your provider offers):
#   google:     LLM_ANALYSIS_PROVIDER=google     LLM_ANALYSIS_BASE_URL=   LLM_ANALYSIS_MODEL=gemini-3.6-flash   LLM_ANALYSIS_API_KEY=your-gemini-api-key
#   anthropic:  LLM_ANALYSIS_PROVIDER=anthropic  LLM_ANALYSIS_BASE_URL=   LLM_ANALYSIS_MODEL=claude-opus-5-5    LLM_ANALYSIS_API_KEY=your-anthropic-api-key (not tested against the real API yet)
#   (google / anthropic: keep LLM_ANALYSIS_BASE_URL empty for the official URL, otherwise calls go to the Ollama URL above)
#   OpenAI:     LLM_ANALYSIS_PROVIDER=openai-compatible  LLM_ANALYSIS_BASE_URL=https://api.openai.com/v1  LLM_ANALYSIS_MODEL=your-openai-model  LLM_ANALYSIS_API_KEY=your-openai-api-key  LLM_ANALYSIS_REASONING_EFFORT=
#     (OpenAI: not tested against the real API yet)
#   OpenAI reasoning models (they reject max_tokens): same as OpenAI, plus LLM_ANALYSIS_MAX_TOKENS_PARAM=max_completion_tokens
#               (same key with LLM_VERDICT_ for a separate verdict provider)

# --- LLM: ai-ready verdict (optional; empty provider = verdict produced by the analysis) ---
LLM_VERDICT_PROVIDER=
LLM_VERDICT_BASE_URL=
LLM_VERDICT_MODEL=
LLM_VERDICT_API_KEY=
LLM_VERDICT_REASONING_EFFORT=
# Example (LiteLLM proxy): LLM_VERDICT_PROVIDER=openai-compatible  LLM_VERDICT_BASE_URL=http://localhost:4000/v1  LLM_VERDICT_MODEL=gemini-3.6-flash  LLM_VERDICT_API_KEY=your-litellm-key
