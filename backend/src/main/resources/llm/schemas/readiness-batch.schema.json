{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "aiReady", "aiReadyReason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "aiReady": { "type": "boolean" },
          "aiReadyReason": { "type": "string" }
        }
      }
    }
  }
}
