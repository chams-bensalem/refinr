# Blocks the commit if gitleaks finds a secret in the staged changes.
# Enable once per clone:  git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (https://github.com/gitleaks/gitleaks). Commit refused." >&2
  exit 1
fi
if ! gitleaks protect --staged --redact --no-banner; then
  echo "pre-commit: gitleaks detected a potential secret in the staged changes. Commit refused." >&2
  exit 1
fi
# Every staged source file must carry the SPDX license header (same check as the CI job "license-headers").
if ! "$(git rev-parse --show-toplevel)/scripts/check-spdx.sh" --staged; then
  echo "pre-commit: source file(s) without the SPDX license header. Commit refused." >&2
  exit 1
fi
