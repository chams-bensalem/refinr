# Refuses commit messages carrying AI attribution trailers.
# Enable once per clone:  git config core.hooksPath .githooks
if grep -qiE 'Co-Authored-By:[[:space:]]*Claude|Generated with Claude Code|Claude-Session:' "$1"; then
  echo "commit-msg: AI attribution found in the commit message (Co-Authored-By: Claude / Generated with Claude Code / Claude-Session:). Commit refused." >&2
  exit 1
fi
